{
  "name": "dsh-context-canvas",
  "version": "0.2.0",
  "description": "DSH ChatBridge Canvas：无限画布式上下文编排插件，把历史对话、文件和提示词连成新对话",
  "license": "MIT",
  "author": "Niall0218",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src",
    "docs",
    "build.mjs",
    "tests"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niall0218/dsh-ChatBridge-canvas.git"
  },
  "homepage": "https://github.com/Niall0218/dsh-ChatBridge-canvas#readme",
  "bugs": {
    "url": "https://github.com/Niall0218/dsh-ChatBridge-canvas/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "canvas",
    "infinite-canvas",
    "context",
    "afc"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/compiler.test.mjs tests/afc.test.mjs",
    "check": "node build.mjs && node --check client.js && node --test tests/compiler.test.mjs tests/afc.test.mjs"
  }
}
